### Phase 2: Multi-Pass Search Strategy (Week 2-3)
```python
def search_all_company_variants(company_profile):
    all_results = []
    
    for search_token in company_profile["search_tokens"]:
        results = scraper.search_company(search_token)
        all_results.extend(results)
    
    # Deduplicate but keep all valid matches
    deduplicated = deduplicate_results(all_results)
    
    # Apply scoring but with lower thresholds for recall
    scored_results = score_results(deduplicated, threshold=0.4)  # Lower threshold
    
    return scored_results
```

### Phase 3: Green Instrument Classification (Week 3-4)
```python
def classify_green_instrument(document_data):
    green_keywords = [
        "green bond", "sustainability", "ESG", "climate", "environmental",
        "sustainable", "renewable", "carbon", "emission", "social bond"
    ]
    
    # Check document title and type
    title_score = sum(1 for keyword in green_keywords 
                     if keyword.lower() in document_data["title"].lower())
    
    # Check document type
    type_score = 1.0 if "green" in document_data["doc_type"].lower() else 0.0
    
    # Combined score
    green_score = (title_score * 0.7) + (type_score * 0.3)
    
    return {
        "is_green": green_score > 0.5,
        "confidence": green_score,
        "classification": "green" if green_score > 0.5 else "non-green"
    }
```

